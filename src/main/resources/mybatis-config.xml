<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE configuration
        PUBLIC "-//mybatis.org//DTD Config 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-config.dtd">

<configuration>
    <settings>
        <setting name="mapUnderscoreToCamelCase" value="true"/>
        <setting name="lazyLoadingEnabled" value="true"/>
        <setting name="aggressiveLazyLoading" value="false"/>
    </settings>

    <typeAliases>
        <package name="woojooin.planit.domain.member.domain"/>
        <package name="woojooin.planit.domain.goal.deposit.dto.res"/>
        <package name="woojooin.planit.domain.goal.domain"/>
    </typeAliases>

    <typeHandlers>
        <typeHandler
                javaType="woojooin.planit.domain.goal.domain.enums.ActionType"
                handler="org.apache.ibatis.type.EnumTypeHandler"/>
        <typeHandler
                javaType="woojooin.planit.domain.product.enums.InvestType"
                handler="org.apache.ibatis.type.EnumTypeHandler"/>
    </typeHandlers>

</configuration>
