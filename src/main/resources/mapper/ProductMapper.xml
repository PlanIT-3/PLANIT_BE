<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="woojooin.planit.domain.product.mapper.ProductMapper">

    <resultMap id="productResultMap" type="woojooin.planit.domain.product.domain.Product">
        <result property="srtnCd" column="srtn_cd"/>
        <result property="isinCd" column="isin_cd"/>
        <result property="itmsNm" column="itms_nm"/>
        <result property="basDt" column="bas_dt"/>
        <result property="clpr" column="clpr"/>
        <result property="vs" column="vs"/>
        <result property="fltRt" column="flt_rt"/>
        <result property="mkp" column="mkp"/>
        <result property="hipr" column="hipr"/>
        <result property="lopr" column="lopr"/>
        <result property="trqu" column="trqu"/>
        <result property="trPrc" column="tr_prc"/>
        <result property="lstgStCnt" column="lstg_st_cnt"/>
        <result property="mrktTotAmt" column="mrkt_tot_amt"/>
        <result property="riskLevel" column="risk_level"/>
    </resultMap>

    <select id="selectByRiskLevel" resultMap="productResultMap">
        SELECT p.*
        FROM product p
                 INNER JOIN (SELECT srtn_cd, MAX(bas_dt) AS max_bas_dt
                             FROM product
                             WHERE risk_level = #{riskLevel}
                             GROUP BY srtn_cd) sub ON p.srtn_cd = sub.srtn_cd AND p.bas_dt = sub.max_bas_dt
        WHERE p.risk_level = #{riskLevel}
        ORDER BY CAST(p.flt_rt AS DECIMAL(10, 4)) DESC
    </select>

    <select id="selectBySrtnCd" resultType="woojooin.planit.domain.product.domain.Product">
        SELECT *
        FROM product
        WHERE srtn_cd = #{srtnCd}
          AND bas_dt = (
            SELECT MAX(bas_dt)
            FROM product
            WHERE srtn_cd = #{srtnCd}
        )
    </select>

</mapper>
