<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="woojooin.planit.domain.openAi.mapper.InvestTypeMapper">

    <select id="getInvestTypeByMemberId"
            parameterType="long"
            resultType="woojooin.planit.domain.openAi.dto.req.InvestTypeReq">
        SELECT
            invest_type,
            stable,
            income,
            liquid,
            growth,
            diversified
        FROM member
        WHERE member_id = #{memberId}
    </select>

</mapper>
